{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "student-guidance-library/weekly-plan-gate-assessment-v1.2",
  "title": "Weekly Plan Gate v1.2 Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_version",
    "phase",
    "gate_result_date",
    "checked_by",
    "plan_sha256",
    "references_checked",
    "results"
  ],
  "properties": {
    "schema_version": {"const": "2.1"},
    "gate_version": {"const": "1.2.1"},
    "phase": {"enum": ["DESIGN", "PRE_EXECUTION", "POST_EXECUTION", "CLOSURE"]},
    "gate_result_date": {"type": "string", "format": "date"},
    "checked_by": {"type": "string", "minLength": 1},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "references_checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "path", "sha256"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "oneOf": [
        {"required": ["pdf_page"]},
        {"required": ["printed_page", "page_map"]},
        {"required": ["section"]},
        {"required": ["paragraph", "text"]}
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "pdf_page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": "string", "minLength": 1},
        "page_map": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "paragraph": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {
        "page_map": ["printed_page"],
        "text": ["paragraph"],
        "paragraph": ["text"]
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "phase",
        "result",
        "information_status",
        "evidence_type",
        "claim",
        "locator",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^[A-Z][0-9]{2}$"},
        "phase": {"enum": ["DESIGN", "PRE_EXECUTION", "POST_EXECUTION", "CLOSURE"]},
        "result": {"enum": ["PASS", "FAIL", "REVIEW", "NOT_APPLICABLE", "NOT_ASSESSABLE_YET"]},
        "information_status": {"enum": ["VERIFIED", "SUPPORTED", "INFERENCE", "UNVERIFIED", "PENDING", "NOT_MEASURED", "NOT_APPLICABLE", "NOT_ASSESSABLE_YET"]},
        "evidence_type": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "level": {"enum": ["BLOCKER", "WARNING", "REVIEW", "INFO"]},
        "escalation_reason": {"type": "string", "minLength": 1},
        "applicability_reason": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    }
  }
}
